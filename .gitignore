# Build output
dist/

# The console's build output. It is produced into the API service so a single
# Cloud Run service serves both, and is regenerated by `npm run build`.
services/api/public/

# Installed dependencies. The repository builds from source, and the images
# install inside the build stage.
node_modules/
package-lock.json

# ------------------------------------------------------------------ Terraform
#
# State first, because it is the one that would actually hurt. terraform.tfstate
# records the attributes of every resource in the deployment, including values
# the configuration takes care to keep out of itself. It is a local working file
# and never belongs in a repository.
#
# terraform.tfvars is the operator's own deployment: project id, domain,
# operator group, support email, image digests. No tfvars file is tracked here,
# and this makes that intent enforced rather than merely observed.
#
# .terraform.lock.hcl is deliberately NOT ignored. Terraform records its
# provider selections there so a later init makes the same choices, which is
# exactly the kind of thing version control is for.
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
*.tfvars.json
tfplan
crash.log

# ---------------------------------------------------------------- Local noise
firestore-debug.log
*.log
.DS_Store

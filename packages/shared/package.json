{
  "name": "@lifecycle/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared model types, transition guard, audit-and-logging library and Firestore data access layer. Owned by the Lifecycle API Service (REQ-010); consumed by the worker.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./logging": "./dist/logging.js",
    "./model": "./dist/model.js",
    "./transitions": "./dist/transitions.js",
    "./store": "./dist/store.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.10.0",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}

{
  "name": "@lifecycle/api",
  "version": "0.1.0",
  "private": true,
  "description": "Operator-facing API and console host. Verifies IAP assertions, owns the operator role model, admits lifecycle requests and records approvals.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.10.0",
    "@google-cloud/secret-manager": "^5.6.0",
    "@google-cloud/tasks": "^5.5.0",
    "@lifecycle/schemas": "*",
    "@lifecycle/shared": "*",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@lifecycle/test-support": "*",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
